REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_anon_key
REACT_APP_ENABLE_DEMO_ACCOUNTS=false

# Live sessions use SignalWire — no frontend env var needed.
# Set SIGNALWIRE_SPACE_URL, SIGNALWIRE_PROJECT_ID, SIGNALWIRE_API_TOKEN
# as Supabase secrets (supabase secrets set --env-file .env.server).

# Payments use Dodo Payments — no frontend env var needed.
# Set DODO_API_KEY, DODO_WEBHOOK_SECRET, DODO_ENV, DODO_PRODUCT_CREATOR,
# DODO_PRODUCT_STUDIO, DODO_PRODUCT_ACADEMY, DODO_PRODUCT_LESSON
# as Supabase secrets.

# AI features use Anthropic — set ANTHROPIC_API_KEY as a Supabase secret.
